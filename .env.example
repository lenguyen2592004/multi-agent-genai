# Multi-Agent GenAI Platform - Environment Configuration
# 
# IMPORTANT: Never commit this file to git!
# Add .env to .gitignore
#
# Supported LLM Providers:
# - groq: Fast inference, cheap (DEFAULT for cloud)
# - ollama: Local LLM (DEFAULT for local dev)
# - gemini: Google Gemini API
# - openai: OpenAI API

# ────────────────────────────────────────────
# LLM Configuration (Pick ONE provider)
# ────────────────────────────────────────────

# Groq (Recommended for cloud - fast & cheap)
# Get key at: https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL=llama-3.1-8b-instant

# Gemini (Google - free tier available)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Most capable - requires payment)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Ollama (Local - no API key needed)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# ────────────────────────────────────────────
# API Security
# ────────────────────────────────────────────
API_BEARER_TOKEN=
RATE_LIMIT_PER_MINUTE=30

# ────────────────────────────────────────────
# GCP Configuration (for deployment)
# ────────────────────────────────────────────
GCP_PROJECT_ID=gen-lang-client-0113521438
GCP_REGION=us-central1
